     (antialiased 2 bool)))
   (opacity
    ((opacity 1 f64)))
   (animated_opacity
    ((opacity 1 f64)
     (animation_id 2 u64)
     (duration_ms 3 u32)
     (curve 4 animation_curve)))
   (projection_effect
    ((matrix3 1 matrix3)))
   (focus_scope
    ((autofocus 1 bool)))
   (hover_region
    ((blocks_behind 1 bool)))
   (keyboard_listener
    ((autofocus 1 bool)
     (key_policy 2 key_policy)))
   (semantics
    ((label 1 optional_string)
     (hint 2 optional_string)
     (value 3 optional_string)
     (role 4 semantics_role)
     (selected 5 optional_bool)
     (children 6 u8)
     (hidden 7 bool)
     (live_region 8 bool)
     (heading_level 9 optional_u8)
     (sort_priority 10 optional_f64)
     (identifier 11 optional_string)
     (actions 12 semantics_actions)))
   (theme
    ((data 1 swiftui_environment)))
   (removal ((request_token 1 i64) (request_state 2 u8) (vertical 3 bool)
     (collapse_vertical 4 bool) (title 5 string) (duration_ms 6 u32)))
   (refresh ((request_token 1 i64) (request_state 2 u8) (show_token 3 optional_i64)))
   (scroll_targets ((vertical 1 bool) (ids 2 i64_list) (position 3 optional_i64)
     (fraction 4 f64) (spacing 5 f64) (alignment 6 u8) (snapping 7 bool)
     (enabled 8 bool) (shows_indicators 9 bool)))
   (menu ((items 1 menu_items) (enabled 2 bool)))
   (picker
    ((selected_id 1 optional_i64)
     (options 2 picker_options) (label 3 string) (style 4 u8) (enabled 5 bool)))
   (slider ((value 1 f64) (min 2 f64) (max 3 f64) (step 4 optional_f64) (enabled 5 bool) (vertical 6 bool) (has_on_change 7 bool) (label 8 string)))
   (range_slider ((start 1 f64) (end_value 2 f64) (min 3 f64) (max 4 f64) (step 5 optional_f64) (enabled 6 bool) (vertical 7 bool) (has_on_change 8 bool) (label_start 9 string) (label_end 10 string)))
   (divider ())
   (label ())
   (date_picker ((selected 1 civil_date) (first 2 civil_date) (last 3 civil_date)
     (label 4 string) (enabled 5 bool)))
   (time_picker ((value 1 civil_time) (format 2 u8) (label 3 string) (enabled 4 bool)))
   (badge ((count 1 optional_u64) (alignment 2 u8) (visible 3 bool)))
