((protocol
  (name bonsai_swiftui)
  (major 9)
  (minor 0)
  (endianness little)
  (header_bytes 48)
  (max_frame_bytes 16777216)
  (max_string_bytes 1048576)
  (max_application_payload_bytes 1048576)
  (max_operations 1000000)
  (max_nodes 1000000))

 (frame_kinds
  ((handshake 1)
   (full_snapshot 2)
   (incremental_frame 3)
   (event_batch 4)
   (runtime_error 5)))

 (operations
  ((begin_frame 1)
   (create_node 2)
   (update_props 3)
   (update_event_bindings 4)
   (set_children 5)
   (set_root 6)
   (drop_node 7)
   (host_request 8)
   (runtime_notification 9)
   (end_frame 10)
   (application_request 11)
   (set_application_theme 12)))

