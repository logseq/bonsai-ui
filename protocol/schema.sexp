   (tab_selected 52 string)))

 (host_requests
  ((clipboard_read 1 unit string_result)
   (clipboard_write 2 string unit_result)
   (open_url 3 uri unit_result)
   (pick_files 4 file_picker_options file_list_result)
   (save_file 5 save_file_options optional_file_result)
