    ((enabled 1 bool)
     (role 2 u8)
     (style 3 u8)
     (autofocus 4 bool)))
   (native_widget
    ((kind_id 1 u32)
     (version 2 u16)
     (capabilities 3 u64)
     (payload 4 bytes)))))

 (event_tags
  ((press 1 unit)
   (long_press 2 unit)
   (tap 3 tap)
   (double_tap 4 tap)
   (pointer_enter 5 pointer)
   (pointer_leave 6 pointer)
   (pointer_down 7 pointer)
   (pointer_up 8 pointer)
   (key 9 key)
   (focus_changed 10 bool)
   (text_edit 11 text_edit)
   (text_submit 12 string)
   (scroll_notification 13 scroll)
   (visible_range_changed 14 visible_range)
   (animation_completed 15 u64)
   (layout_observed 17 layout)
   (value_changed 18 bool)
