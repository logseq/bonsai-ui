diff --git a/lib_eio_posix/net.ml b/lib_eio_posix/net.ml
index 5280dba..021ae4f 100644
--- a/lib_eio_posix/net.ml
+++ b/lib_eio_posix/net.ml
@@ -100,8 +100,12 @@ let getaddrinfo ~service node =
   Err.run (Eio_unix.run_in_systhread ~label:"getaddrinfo") @@ fun () ->
   let rec aux () =
     try
-      Unix.getaddrinfo node service []
-      |> List.filter_map to_eio_sockaddr_t
+      let resolve socktype =
+        Unix.getaddrinfo node service [Unix.AI_SOCKTYPE socktype]
+      in
+      List.concat
+        [ resolve Unix.SOCK_STREAM; resolve Unix.SOCK_DGRAM ]
