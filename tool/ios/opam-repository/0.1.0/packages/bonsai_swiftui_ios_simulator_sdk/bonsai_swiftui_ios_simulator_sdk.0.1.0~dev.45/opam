  "bonsai_swiftui" {= "0.1.0~dev"}
  "bonsai_swiftui_ios_simulator_runtime_sdk" {= "0.1.0~dev.8"}
]
build: [
  ["sh" "./build-installed-framework.sh" "%{switch}%" "%{prefix}%" "iossimulator"]
]
install: [
  ["cp" "-R" ".bonsai_swiftui_ios_framework_sdk/stage/ios-sysroot/." "%{prefix}%/ios-sysroot/"]
  ["mkdir" "-p" "%{share}%/bonsai_swiftui_ios_simulator_sdk"]
  ["cp" "manifest.sexp" "%{share}%/bonsai_swiftui_ios_simulator_sdk/manifest.sexp"]
  ["cp" "package-lock.sexp" "%{share}%/bonsai_swiftui_ios_simulator_sdk/package-lock.sexp"]
]
available: os = "macos" & arch = "arm64"
