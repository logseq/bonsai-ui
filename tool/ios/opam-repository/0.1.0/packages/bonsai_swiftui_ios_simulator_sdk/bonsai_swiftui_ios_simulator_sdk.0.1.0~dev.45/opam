dev-repo: "git+https://github.com/logseq/bonsai-ui.git"
extra-source "bonsai_swiftui.tar.gz" {
  src: "https://github.com/logseq/bonsai-ui/archive/d8be5273407e8137e1d1a073f732ef4e702509e3.tar.gz"
  checksum: ["sha256=9acfb3a7a26c5c7d68cea47d91b762eea7a7bcf417917d315f22e28e2bd65489"]
}
extra-files: [
  ["build-installed-framework.sh" "sha256=098b541cf180d97e8571c2939e326f0a037d768e488b34477644bcdf5f428223"]
  ["manifest.sexp" "sha256=e43e1f71cf8a6aac565c3bb96c6eaf796b1ac8360c739f5b88e94c9ccc1d44f3"]
  ["package-lock.sexp" "sha256=37f8fa40ec75b6db0c0d28c744664e81f3ef0ff5d5019ff001f5c291d0022842"]
