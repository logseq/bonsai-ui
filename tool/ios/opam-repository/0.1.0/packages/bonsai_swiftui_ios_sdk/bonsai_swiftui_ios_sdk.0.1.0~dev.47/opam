extra-source "bonsai_swiftui.tar.gz" {
  src: "https://github.com/logseq/bonsai-ui/archive/02e68004cb7a8005cebf85655b0f788b68ae44a1.tar.gz"
  checksum: ["sha256=49c580c5bca743d1d34cfad5e96d41a351585de4377239280d8db48ac12e4f2b"]
}
extra-files: [
  ["build-installed-framework.sh" "sha256=d3e4ea13a86708c58d0863b50039270a42b5430c349d1a2f9089075e40f0af60"]
  ["manifest.sexp" "sha256=c56e85795ef21c0d9702aba984e01a620d2e5eda70ba890a4f05f623da04a3d3"]
