(lang 4)
(app
 (name host_navigation)
 (apple_root apple)
 (native_target ocaml/native_embed.exe.o)
 (features)
 (macos (bundle_identifier org.bonsai-swiftui.example.host-navigation) (minimum_version 26.0) (architectures arm64))
 (ios (bundle_identifier org.bonsai-swiftui.example.host-navigation) (minimum_version 26.0) (architectures arm64)))
