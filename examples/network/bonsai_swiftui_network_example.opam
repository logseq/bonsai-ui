opam-version: "2.0"
name: "bonsai_swiftui_network_example"
version: "0.1.0~dev"
synopsis: "Secure HTTPS and WebSocket example for bonsai_swiftui"
description: """
An OCaml-owned HTTPS and secure WebSocket example using Eio, tls-eio,
ca-certs-nss, httpun-eio, and httpun-ws behind the bonsai_swiftui Worker
Domain.
"""
maintainer: "bonsai_swiftui contributors"
authors: ["bonsai_swiftui contributors"]
license: "MIT"
homepage: "https://github.com/logseq/bonsai-ui"
bug-reports: "https://github.com/logseq/bonsai-ui/issues"
dev-repo: "git+https://github.com/logseq/bonsai-ui.git"
depends: [
  "ocaml" {= "5.1.1"}
  "dune" {>= "3.17"}
  "bonsai_swiftui" {= version}
  "alcotest" {= "1.7.0" & with-test}
  "base" {>= "v0.17" & < "v0.18~"}
  "bonsai" {>= "v0.17" & < "v0.18~"}
  "core" {>= "v0.17" & < "v0.18~"}
  "incr_dom" {>= "v0.17" & < "v0.18~"}
  "virtual_dom" {>= "v0.17" & < "v0.18~"}
  "eio" {= "1.2"}
  "eio_posix" {= "1.2"}
  "bigstringaf" {= "0.10.0"}
  "cstruct" {= "6.2.0"}
  "digestif" {= "1.3.1"}
  "domain-name" {= "0.5.0"}
  "gluten" {= "0.5.2"}
  "gluten-eio" {= "0.5.2"}
  "httpun" {= "0.2.0"}
  "httpun-eio" {= "0.2.0"}
  "httpun-ws" {= "0.2.0"}
  "ca-certs-nss" {= "3.126"}
  "mirage-crypto-rng" {= "2.2.0"}
  "ptime" {= "1.2.0"}
  "tls" {= "2.1.2"}
  "tls-eio" {= "2.1.2"}
  "uri" {= "4.4.0"}
  "x509" {= "1.1.1"}
]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
available: arch != "x86_32"
